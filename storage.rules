rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/staffAllowlist/$(request.auth.token.email.lower()));
    }

    match /{allPaths=**} {
      allow read, write: if isStaff();
    }
  }
}
