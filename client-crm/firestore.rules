rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function myEmail() {
      return request.auth.token.email.lower();
    }
    // בעלות המערכת: מנהלות תמיד, גם כשרשימת הצוות ריקה לגמרי.
    // בלי זה נוצר מבוי סתום במערכת חדשה - כתיבה לרשימת הצוות מותרת רק
    // למנהלת, ובמסד נתונים ריק אף אחת אינה מנהלת, ולכן איש לא יכול להתחיל.
    // חייב להישאר זהה ל-BOOTSTRAP_ADMIN_EMAILS שב-lib/appConfig.js.
    function isFounder() {
      return request.auth != null
        && myEmail() in [
          "reut1803@gmail.com",
          "6253322@gmail.com"
        ];
    }
    function isStaff() {
      return request.auth != null
        && (isFounder()
          || exists(/databases/$(database)/documents/staffAllowlist/$(myEmail())));
    }
    function isAdmin() {
      return request.auth != null
        && (isFounder()
          || get(/databases/$(database)/documents/staffAllowlist/$(myEmail())).data.role == "admin");
    }
    function notBlockedFromMe() {
      return isAdmin()
        || !(myEmail() in resource.data.get('blockedStaffEmails', []));
    }

    match /staffAllowlist/{email} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /candidates/{candidateId} {
      allow get: if isStaff() && notBlockedFromMe();
      allow list: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff() && notBlockedFromMe();
      allow delete: if isAdmin();
    }

    // אוסף ציבורי וצר: מכיל רק שם וסטטוס פניות, כדי שהקישור האישי של מועמד/ת
    // (ללא התחברות) לעולם לא ייתן גישה לשאר פרטי הכרטיס החסויים.
    match /candidateStatus/{candidateId} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if isStaff();
      // עדכון ללא התחברות מוגבל לשדות שהמועמד/ת עצמו/ה מעדכן/ת מהקישור
      // האישי: סטטוס הזמינות, ובחירת המסלול האישי וההודעה שנלווית לה.
      // כל שדה אחר בכרטיס אינו ניתן לנגיעה מכאן.
      allow update: if isStaff()
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['availabilityStatus', 'personalTrack', 'trackMessage', 'trackUpdatedAt'])
            && request.resource.data.get('trackMessage', '') is string
            && request.resource.data.get('trackMessage', '').size() < 2000);
    }

    // מדיה (הקלטות/PDF) נשמרת בחלקים קטנים, כי רשתות מסוימות לא מעבירות בקשה אחת גדולה.
    // מסמך הכתר ב-media מחזיק את סוג הקובץ ומספר החלקים, והתוכן עצמו יושב ב-mediaChunks.
    match /media/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isStaff();
    }

    match /mediaChunks/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isStaff();
    }

    match /proposals/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // זירת סיעור המוחות: סבב דיון של הצוות על מועמד/ת אחד/ת.
    // רק המנהלת פותחת, סוגרת, מסכמת ומוחקת סבב. הצוות קורא ומשתתף.
    match /brainstormRounds/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // כרטיסיות הדיון. כל אשת צוות כותבת ומסמנת לייקים.
    // מחיקה: המנהלת, או הכותב/ת של הכרטיסייה עצמה.
    match /brainstormNotes/{id} {
      allow read, create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin() || (isStaff() && resource.data.get('authorEmail', '') == myEmail());
    }

    // משימות: המנהלת רואה הכל. אשת צוות רואה אך ורק משימות שמשויכות אליה,
    // ולכן היא חייבת לשלוח שאילתה מסוננת לפי assigneeId (כפי שהאפליקציה עושה).
    function isMyTask() {
      return resource.data.get('assigneeId', '') == myEmail();
    }

    match /tasks/{id} {
      allow get, list: if isAdmin() || (isStaff() && isMyTask());
      allow create: if isStaff();
      allow update: if isAdmin() || (isStaff() && isMyTask());
      allow delete: if isAdmin();
    }

    match /telemetry/{staffEmail} {
      allow read: if isStaff();
      allow write: if isStaff() && myEmail() == staffEmail;
    }

    match /termsAcceptances/{staffEmail} {
      allow read: if isStaff();
      allow write: if isStaff() && myEmail() == staffEmail;
    }

    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /emailLog/{id} {
      allow read, write: if isAdmin();
    }

    match /serviceTypes/{id} {
      allow read, write: if isAdmin();
    }

    match /charges/{id} {
      allow read, write: if isAdmin();
    }

    // מפתח חיפוש לפי שם, עבור טופס ההרשמה הציבורי.
    // get מותר לכולם - כדי שהעמוד הציבורי יוכל לבדוק שם מדויק אחד.
    // list אסור לכל מי שאינו צוות, וזו ההגנה: אי אפשר לסרוק מכאן שמות.
    match /nameIndex/{key} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // פניות מהטופס החיצוני. כל אחד יכול להפקיד פנייה, ואיש אינו יכול לקרוא
    // אותן חוץ מהצוות. הפנייה אינה נכנסת ישירות למאגר המועמדים אלא לאוסף
    // נפרד, והמנהלת היא שמאשרת ויוצרת ממנה כרטיס.
    match /intakeSubmissions/{id} {
      allow create: if request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('name', '') is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() < 120
        && request.resource.data.get('phone', '') is string
        && request.resource.data.phone.size() < 40
        // התמונה נשמרת מכווצת בתוך המסמך, כי הטופס הציבורי אינו מורשה
        // לכתוב לאוסף המדיה. התקרה כאן היא הגנה מפני העלאה מנופחת.
        && request.resource.data.get('photo', '') is string
        && request.resource.data.get('photo', '').size() < 500000;
      allow get, list: if isStaff();
      // מיד אחרי השליחה, מסך הסיום מאפשר לבחור את המסלול האישי ולהשאיר
      // הודעה. זו הכתיבה היחידה שמותרת לפנייה מבחוץ, והיא מוגבלת לשלושת
      // השדות האלה ולפנייה שטרם טופלה.
      allow update: if isAdmin()
        || (resource.data.get('status', '') == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['personalTrack', 'trackMessage', 'trackUpdatedAt'])
            && request.resource.data.get('trackMessage', '') is string
            && request.resource.data.get('trackMessage', '').size() < 2000);
      allow delete: if isAdmin();
    }

    match /userPrefs/{email} {
      allow read, write: if request.auth != null && myEmail() == email;
    }
  }
}
