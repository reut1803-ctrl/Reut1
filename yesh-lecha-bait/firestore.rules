rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function roleOf() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return signedIn() && roleOf() == 'admin'; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == 'pending';
      // משתמשת לא משנה לעצמה תפקיד; אזור אחריות נקבע פעם אחת בלבד
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        (!('territory' in resource.data) || request.resource.data.territory == resource.data.territory)
      );
      allow delete: if isAdmin();
    }

    // משפחות: ההנהלה רואה הכול; אשת צוות רואה רק את המשפחות שמשויכות אליה,
    // ויכולה לעדכן בהן רק סטטוס ויומן קשר.
    match /families/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.assignedTo);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid in resource.data.assignedTo &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'statusUpdatedAt', 'lastContactAt', 'contactLog'])
      );
    }
  }
}
