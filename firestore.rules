rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // המנהלת הראשונה. היא מזוהה כמנהלת-על גם כשרשימת הצוות ריקה לגמרי,
    // אחרת אי אפשר היה להיכנס למערכת חדשה כדי להוסיף אליה את אנשי הצוות.
    function bootstrapAdminEmail() {
      return "reut1803@gmail.com";
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function hasEmail() {
      return request.auth != null && "email" in request.auth.token;
    }
    function isBootstrapAdmin() {
      return hasEmail() && myEmail() == bootstrapAdminEmail();
    }
    function isStaff() {
      return isBootstrapAdmin()
        || (hasEmail()
            && exists(/databases/$(database)/documents/staffAllowlist/$(myEmail())));
    }
    function isAdmin() {
      return isBootstrapAdmin()
        || (hasEmail()
            && exists(/databases/$(database)/documents/staffAllowlist/$(myEmail()))
            && get(/databases/$(database)/documents/staffAllowlist/$(myEmail())).data.role == "admin");
    }
    function notBlockedFromMe() {
      return isAdmin()
        || !(myEmail() in resource.data.get('blockedStaffEmails', []));
    }

    match /staffAllowlist/{email} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /candidates/{candidateId} {
      allow get: if isStaff() && notBlockedFromMe();
      allow list: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff() && notBlockedFromMe();
      allow delete: if isAdmin();
    }

    // אוסף ציבורי וצר: מכיל רק שם וסטטוס פניות, כדי שהקישור האישי של מועמד/ת
    // (ללא התחברות) לעולם לא ייתן גישה לשאר פרטי הכרטיס החסויים.
    match /candidateStatus/{candidateId} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availabilityStatus']);
    }

    // מדיה (הקלטות/PDF) נשמרת בחלקים קטנים, כי רשתות מסוימות לא מעבירות בקשה אחת גדולה.
    // מסמך הכתר ב-media מחזיק את סוג הקובץ ומספר החלקים, והתוכן עצמו יושב ב-mediaChunks.
    match /media/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isStaff();
    }

    match /mediaChunks/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isStaff();
    }

    match /proposals/{id} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // משימות: המנהלת רואה ומעדכנת הכל. אשת צוות רואה ומעדכנת אך ורק משימות
    // שמשויכות אליה, כך שההגבלה נאכפת בשרת ולא רק במסך.
    match /tasks/{id} {
      // בשאילתת רשימה הכלל נבדק מול כל מסמך שמוחזר, ולכן שאילתה לא מסוננת
      // של אשת צוות תיחסם כולה - וזו בדיוק ההגנה הרצויה.
      allow read: if isAdmin() || (isStaff() && resource.data.assigneeId == myEmail());
      allow create: if isAdmin()
        || (isStaff() && request.resource.data.assigneeId == myEmail());
      allow update: if isAdmin() || (isStaff() && resource.data.assigneeId == myEmail());
      allow delete: if isAdmin();
    }

    match /telemetry/{staffEmail} {
      allow read: if isStaff();
      allow write: if isStaff() && myEmail() == staffEmail;
    }

    match /termsAcceptances/{staffEmail} {
      allow read: if isStaff();
      allow write: if isStaff() && myEmail() == staffEmail;
    }

    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /emailLog/{id} {
      allow read, write: if isAdmin();
    }

    match /serviceTypes/{id} {
      allow read, write: if isAdmin();
    }

    match /charges/{id} {
      allow read, write: if isAdmin();
    }

    match /userPrefs/{email} {
      allow read, write: if request.auth != null && myEmail() == email;
    }

    // ---------------------------------------------------------------
    //  צד השאלון ומסך הניהול הישן (אוספים עם הקידומת "form_").
    // ---------------------------------------------------------------
    //  מועמד/ת שממלא/ת את השאלון אינו/ה מחובר/ת עם גוגל אלא בהתחברות
    //  אנונימית, ולכן חייבת להיות כאן הרשאת כתיבה למשתמש אנונימי.
    //  מחיקה נשמרת לצוות מזוהה בלבד.

    match /form_candidates/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if isStaff();
    }

    match /form_reps/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if isStaff();
    }

    match /form_tasks/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if isStaff();
    }

    match /form_matches/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if isStaff();
    }

    match /form_meta/{id} {
      allow read, create, update: if request.auth != null;
      allow delete: if isStaff();
    }
  }
}
